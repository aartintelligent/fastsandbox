{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "fastsandbox",
      "initial-version": "0.1.0",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Performance" },
        { "type": "docs", "section": "Documentation" },
        { "type": "refactor", "section": "Changed" },
        { "type": "deprecate", "section": "Deprecated" },
        { "type": "revert", "section": "Reverted" },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "Continuous integration", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true }
      ],
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fastsandbox-native')].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='fastsandbox')].version"
        },
        { "type": "json", "path": "plugins/fastsandbox/.claude-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    }
  }
}
