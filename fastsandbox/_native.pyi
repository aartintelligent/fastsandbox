"""Type stubs of the native extension, `fastsandbox._native`.

The extension is private: payloads cross it as plain Python objects in the
serde shape of `docker-sandbox`, which the public API validates into the models
of `fastsandbox.models`. Every coroutine-like method returns an awaitable
running on the shared tokio runtime.
"""

from collections.abc import AsyncIterator, Awaitable
from os import PathLike
from pathlib import Path
from typing import Any

__version__: str
SOCKET_ENV: str
SUPPORTED_API: tuple[str, str]

def connect(
    socket: str | PathLike[str] | None = None,
    timeout: float | None = None,
    long_operation_timeout: float | None = None,
    version_policy: str | None = None,
) -> Awaitable[Client]: ...
def default_socket_path() -> Path | None: ...

class Client:
    @property
    def socket_path(self) -> Path: ...
    @property
    def health(self) -> Any: ...
    def daemon(self) -> Daemon: ...
    def sandboxes(self) -> Sandboxes: ...
    def sandbox(self, name: str) -> Sandbox: ...
    def images(self) -> Images: ...
    def events(self) -> Events: ...
    def policy(self) -> Policy: ...
    def mcp(self) -> Mcp: ...
    def prompts(self) -> Prompts: ...

